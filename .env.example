# Local database used by Docker Compose
DB_NAME=mail-system
DB_USER=mail-system
DB_PASSWORD=mail-system
DB_DDL_AUTO=update

# Keycloak development setup
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PUBLIC_URL=https://localhost/auth
OIDC_ISSUER_URI=https://localhost/auth/realms/mail-system
OIDC_JWK_SET_URI=http://keycloak:8080/auth/realms/mail-system/protocol/openid-connect/certs
OIDC_DISCOVERY_URL=https://localhost/auth/realms/mail-system/.well-known/openid-configuration
APP_CORS_ALLOWED_ORIGINS=https://localhost,http://localhost:4200

# S3-compatible attachment storage
ATTACHMENT_MAX_FILE_SIZE=5MB
ATTACHMENT_MAX_REQUEST_SIZE=10MB
STORAGE_S3_ENDPOINT=http://seaweedfs:8333
STORAGE_S3_BUCKET=mail-attachments
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=mail-system
STORAGE_S3_SECRET_KEY=mail-system-secret

# SMTP (optional; leaving the host empty disables actual delivery)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
SPRING_MAIL_DEBUG=false
SPRING_MAIL_SSL_TRUST=mailgate.thm.de

# IMAP (optional; leaving the host or credentials empty disables polling)
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=INBOX
MAIL_IMAP_POLL_INTERVAL_MS=5000
